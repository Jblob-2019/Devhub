{
  "name": "my-app",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "client-dev": "npm run dev --workspace apps/client",
    "server-dev": "npm run dev --workspace apps/server",
    "dev": "concurrently \"npm run dev --workspace apps/client\" \"npm run dev --workspace apps/server\"",
    "client-build": "npm run build --workspace apps/client",
    "server-build": "npm run build --workspace apps/server",
    "build": "concurrently \"npm run build --workspace apps/client\" \"npm run build --workspace apps/server\"",
    "render-build": "npm install && npm run server-build",
    "start": "npm run start --workspace apps/server",
    "render-start": "npm run start --workspace apps/server"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/jsonwebtoken": "^9.0.10",
    "concurrently": "^8.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "jsonwebtoken": "^9.0.3"
  }
}
